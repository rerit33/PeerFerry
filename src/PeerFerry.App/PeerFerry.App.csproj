<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PeerFerry.Core\PeerFerry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PeerFerry</AssemblyName>
    <RootNamespace>PeerFerry.App</RootNamespace>
    <StartupObject>PeerFerry.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PeerFerry.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup><Resource Include="Assets\PeerFerry.ico" /></ItemGroup>

</Project>
