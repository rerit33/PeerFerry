<Window x:Class="PeerFerry.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — PeerFerry" Width="840" Height="700" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl>
      <TabItem Header="Сеть"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Имя участника"/><TextBox x:Name="NameBox" MaxLength="80" Margin="0,6,0,16"/>
          <TextBlock Text="Где искать участников и передавать файлы"/><ComboBox x:Name="ModeBox" Margin="0,6,0,8" Padding="8" SelectionChanged="ModeChanged"><ComboBoxItem Tag="Auto" Content="Автоматически — ZeroTier и Radmin VPN"/><ComboBoxItem Tag="Manual" Content="Выбрать адаптеры вручную"/><ComboBoxItem Tag="All" Content="Все активные адаптеры"/></ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Выбор ограничивает поиск и передачу. Если выбранный адаптер отключится, приложение будет ждать его восстановления." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
        <DataGrid x:Name="AdaptersGrid" Grid.Row="2" IsReadOnly="False" RowHeight="52"><DataGrid.Columns>
          <DataGridTemplateColumn Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Адаптер" Binding="{Binding Name}" Width="220" IsReadOnly="True"/><DataGridTextColumn Header="IPv4" Binding="{Binding Addresses}" Width="160" IsReadOnly="True"/><DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Порт подключения" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="PortBox" Width="95"/></StackPanel><TextBlock Text="По умолчанию: TCP 45831, поиск: UDP 45832. Брандмауэр должен разрешать входящие подключения PeerFerry для выбранной сети." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Передачи"><StackPanel Margin="16"><TextBlock Text="Папка загрузок"/><DockPanel Margin="0,6,0,22"><Button Content="Выбрать…" DockPanel.Dock="Right" Click="BrowseDownloads" Margin="10,0,0,0"/><TextBox x:Name="DownloadBox"/></DockPanel>
        <TextBlock Text="Ограничение приёма, КиБ/с (0 — без ограничения)"/><TextBox x:Name="DownloadLimitBox" Margin="0,6,0,16"/>
        <TextBlock Text="Ограничение отдачи, КиБ/с (0 — без ограничения)"/><TextBox x:Name="UploadLimitBox" Margin="0,6,0,16"/>
        <TextBlock Text="Одновременных загрузок (остальные ждут в очереди)"/><TextBox x:Name="ConcurrencyBox" Margin="0,6,0,16"/>
        <TextBlock Text="Полученные файлы остаются на диске после удаления раздачи из списка. Передача папок не требует архива." Style="{StaticResource Hint}"/>
      </StackPanel></TabItem>
      <TabItem Header="Приложение"><StackPanel Margin="16"><CheckBox x:Name="TrayBox" Content="Сворачивать в трей при закрытии окна" Margin="0,0,0,18"/><CheckBox x:Name="UpdatesBox" Content="Автоматически проверять обновления" Margin="0,0,0,18"/>
        <TextBlock Text="GitHub-репозиторий обновлений"/><TextBox x:Name="RepositoryBox" Margin="0,6,0,12"/><TextBlock Text="Обновление скачивается через обычное интернет-подключение. Перезапуск выполняется по вашей команде с сохранением передач." Style="{StaticResource Hint}"/>
        <TextBlock Text="PeerFerry · MIT License" Margin="0,32,0,8" FontWeight="SemiBold"/><TextBlock Text="Приглашение даёт доступ к группе и её раздачам. Передавайте его только тем, кого хотите видеть в группе." Style="{StaticResource Hint}"/>
      </StackPanel></TabItem>
    </TabControl>
    <DockPanel Grid.Row="1" Margin="0,18,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Сохранить" Click="Save" IsDefault="True"/><Button Content="Отмена" IsCancel="True" Margin="0"/></StackPanel><TextBlock x:Name="ErrorLabel" Foreground="#B42318" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel>
  </Grid>
</Window>
