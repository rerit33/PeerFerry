<Window x:Class="PeerFerry.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:PeerFerry.App.Controls" Title="PeerFerry" Width="1200" Height="850" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <DataTemplate x:Key="NameCell"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel></DataTemplate>
    <DataTemplate x:Key="FileCell"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="{Binding Icon}" Width="22" Height="22" Margin="0,0,12,0"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}"/></StackPanel></DataTemplate>
    <DataTemplate x:Key="PersonCell"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="People" Margin="0,0,12,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="OpenSettings" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="Settings" Margin="0,0,9,0"/><TextBlock Text="Настройки"/></StackPanel></Button>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Primary}" Click="AddFiles"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="Add" Margin="0,0,9,0"/><TextBlock Text="Добавить файлы"/></StackPanel></Button>
          <Button Style="{StaticResource Quiet}" Click="ShowAddMenu" Padding="6" Margin="2,0,12,0" ToolTip="Добавить папку" AutomationProperties.Name="Другие способы добавления"><ui:AppIcon Kind="ChevronDown" Width="16" Height="16"/><Button.ContextMenu><ContextMenu><MenuItem Header="Добавить папку…" Click="AddFolder"/></ContextMenu></Button.ContextMenu></Button>
          <Button Click="CreateInvitation"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="Invite" Margin="0,0,9,0"/><TextBlock Text="Пригласить"/></StackPanel></Button>
          <Button Style="{StaticResource Quiet}" Click="ShowAddMenu" Padding="6" Margin="2,0,12,0" ToolTip="Присоединиться по приглашению" AutomationProperties.Name="Присоединиться"><ui:AppIcon Kind="ChevronDown" Width="16" Height="16"/><Button.ContextMenu><ContextMenu><MenuItem Header="Присоединиться по приглашению…" Click="JoinGroup"/></ContextMenu></Button.ContextMenu></Button>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Margin="0,1,16,1"/>
          <Button Style="{StaticResource Quiet}" Click="ShowFriends"><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="People" Margin="0,0,9,0"/><TextBlock x:Name="FriendsLabel" Text="Друзья · 0 в сети"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="220"/><RowDefinition Height="5"/><RowDefinition x:Name="DetailsRow" Height="260"/></Grid.RowDefinitions>
      <TabControl x:Name="Tabs" SelectionChanged="TabChanged">
        <TabItem Header="Доступные файлы">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="18,12" LastChildFill="False">
              <Grid DockPanel.Dock="Right" Width="280"><TextBox x:Name="CatalogSearch" TextChanged="FiltersChanged" Padding="34,7,10,7" ToolTip="Поиск доступных файлов" AutomationProperties.Name="Поиск доступных файлов"/><ui:AppIcon Kind="Search" Foreground="{StaticResource Muted}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Поиск файлов…" Foreground="{StaticResource Muted}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CatalogSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <ComboBox Style="{StaticResource Picker}" x:Name="OwnerFilter" Width="230" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FiltersChanged" AutomationProperties.Name="Участник каталога"/>
              <Button Style="{StaticResource Quiet}" Margin="10,0,0,0" Click="RefreshPeers" ToolTip="Обновить каталог" AutomationProperties.Name="Обновить каталог"><ui:AppIcon Kind="Refresh"/></Button>
            </DockPanel>
            <Grid Grid.Row="1"><DataGrid x:Name="CatalogGrid" SelectionChanged="CatalogSelected" MouseDoubleClick="CatalogDoubleClick"><DataGrid.Columns>
              <DataGridTemplateColumn Header="Файл" Width="2.5*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileCountText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="*" MinWidth="95"/>
              <DataGridTextColumn Header="Участники" Binding="{Binding Owners}" Width="1.5*" MinWidth="120"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="1.3*" MinWidth="142"/>
              <DataGridTemplateColumn Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" Click="CatalogAction" Padding="12,5" MinWidth="100"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid><TextBlock x:Name="CatalogEmpty" Text="Здесь появятся файлы участников вашей группы.&#10;Пригласите друзей и проверьте выбранные сети." Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="24" IsHitTestVisible="False"/></Grid>
          <Button Grid.Row="2" Margin="18,14" Padding="12" Click="AddFiles" Background="#FAFCFA" BorderThickness="0" HorizontalContentAlignment="Stretch"><Button.Template><ControlTemplate TargetType="Button"><Grid><Rectangle Stroke="#C8D1C9" StrokeDashArray="3,3" RadiusX="5" RadiusY="5" Fill="{TemplateBinding Background}"/><ContentPresenter Margin="12" HorizontalAlignment="Center"/></Grid></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="Down" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><TextBlock Text="Перетащите файлы или папки, чтобы поделиться" Foreground="{StaticResource Muted}"/></StackPanel></Button></Grid>
        </TabItem>
        <TabItem Header="Передачи">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="18,12" LastChildFill="False"><Grid DockPanel.Dock="Right" Width="260"><TextBox x:Name="TransferSearch" TextChanged="FiltersChanged" Padding="34,7,10,7" ToolTip="Поиск передач" AutomationProperties.Name="Поиск передач"/><ui:AppIcon Kind="Search" Foreground="{StaticResource Muted}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Поиск файлов…" Foreground="{StaticResource Muted}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TransferSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <StackPanel Orientation="Horizontal"><RadioButton x:Name="FilterAll" Content="Все" Tag="All" GroupName="Transfers" IsChecked="True" Style="{StaticResource Filter}" Checked="TransferFilterChanged"/><RadioButton Content="Загружаются" Tag="Downloading" GroupName="Transfers" Style="{StaticResource Filter}" Checked="TransferFilterChanged"/><RadioButton Content="Раздаются" Tag="Seeding" GroupName="Transfers" Style="{StaticResource Filter}" Checked="TransferFilterChanged"/><RadioButton Content="Приостановлены" Tag="Paused" GroupName="Transfers" Style="{StaticResource Filter}" Checked="TransferFilterChanged"/></StackPanel>
            </DockPanel>
            <Grid Grid.Row="1"><DataGrid x:Name="TransfersGrid" SelectionChanged="TransferSelected"><DataGrid.Columns>
              <DataGridTemplateColumn Header="Файл" CellTemplate="{StaticResource NameCell}" Width="2.3*" MinWidth="235"/>
              <DataGridTemplateColumn Header="Прогресс" Width="1.8*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ProgressText}" FontSize="13" Margin="0,0,0,7"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Приём" Binding="{Binding DownloadText}" Width="*" MinWidth="96"/>
              <DataGridTextColumn Header="Отдача" Binding="{Binding UploadText}" Width="*" MinWidth="96"/>
              <DataGridTextColumn Header="Осталось" Binding="{Binding RemainingText}" Width="*" MinWidth="96"/>
              <DataGridTemplateColumn Width="146"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="ToggleTransfer" ToolTip="{Binding ActionHint}" AutomationProperties.Name="{Binding ActionHint}"><ui:AppIcon Kind="{Binding ActionIcon}"/></Button><Button Style="{StaticResource IconButton}" Click="OpenTransferFolder" Margin="6,0,6,0" ToolTip="Открыть папку" AutomationProperties.Name="Открыть папку"><ui:AppIcon Kind="Folder"/></Button><Button Style="{StaticResource IconButton}" Click="ShowTransferMenu" ToolTip="Действия" AutomationProperties.Name="Действия передачи"><ui:AppIcon Kind="More"/><Button.ContextMenu><ContextMenu><MenuItem Header="Убрать из передач (файлы сохранятся)" Click="RemoveTransfer"/></ContextMenu></Button.ContextMenu></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid><TextBlock x:Name="TransfersEmpty" Text="Добавьте файл или папку, чтобы поделиться ими.&#10;Загрузки из каталога тоже появятся здесь." Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="24" IsHitTestVisible="False"/></Grid>
            <Button Grid.Row="2" Margin="18,14" Padding="12" Click="AddFiles" Background="#FAFCFA" BorderThickness="0" HorizontalContentAlignment="Stretch"><Button.Template><ControlTemplate TargetType="Button"><Grid><Rectangle Stroke="#C8D1C9" StrokeDashArray="3,3" RadiusX="5" RadiusY="5" Fill="{TemplateBinding Background}"/><ContentPresenter Margin="12" HorizontalAlignment="Center"/></Grid></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal"><ui:AppIcon Kind="Down" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/><TextBlock Text="Перетащите файлы или папки, чтобы поделиться" Foreground="{StaticResource Muted}"/></StackPanel></Button>
          </Grid>
        </TabItem>
      </TabControl>
      <GridSplitter x:Name="DetailsSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#F2F4F2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="22,12,18,8" LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="ToggleDetails" ToolTip="Свернуть или раскрыть подробности" AutomationProperties.Name="Подробности раздачи"><ui:AppIcon x:Name="DetailsChevron" Kind="ChevronDown"/></Button>
            <Button x:Name="DetailDownload" DockPanel.Dock="Right" Click="DownloadSelected" Style="{StaticResource Primary}" Content="Скачать" Margin="12,0" Visibility="Collapsed"/>
            <StackPanel><TextBlock x:Name="DetailName" Text="Выберите раздачу" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailSummary" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          </DockPanel>
          <Grid Grid.Row="1" x:Name="DetailBody">
            <TabControl x:Name="TransferDetails" SelectionChanged="TabChanged"><TabItem Header="Общее"><DataGrid x:Name="GeneralInfo" HeadersVisibility="None" RowHeight="30" Margin="18,10"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Label}" Width="155"/><DataGridTextColumn Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Участники"><Grid Margin="18,12"><DataGrid x:Name="TransferParticipants" RowHeight="34"><DataGrid.Columns><DataGridTemplateColumn Header="Участник" CellTemplate="{StaticResource PersonCell}" Width="2*"/><DataGridTextColumn Header="Получаем" Binding="{Binding Download}" Width="*"/><DataGridTextColumn Header="Отдаём" Binding="{Binding Upload}" Width="*"/><DataGridTextColumn Header="Доступно" Binding="{Binding Available}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ParticipantsEmpty" Text="Участники появятся после подключения к раздаче." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></TabItem><TabItem Header="Файлы"><DataGrid x:Name="TransferFiles" RowHeight="34" Margin="18,12"><DataGrid.Columns><DataGridTemplateColumn Header="Файл" CellTemplate="{StaticResource FileCell}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="140"/><DataGridTextColumn Header="Получено" Binding="{Binding Progress}" Width="140"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
            <TabControl x:Name="CatalogDetails"><TabItem Header="Содержимое"><Grid Margin="18,12"><DataGrid x:Name="CatalogFiles" RowHeight="34"><DataGrid.Columns><DataGridTemplateColumn Header="Файл" CellTemplate="{StaticResource FileCell}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="150"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ContentNotice"><TextBlock x:Name="ContentMessage" Text="Выберите раздачу, чтобы посмотреть её содержимое." Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="650" TextAlignment="Center"/><Button x:Name="RetryContent" Content="Повторить" Click="RetryMetadata" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Grid></TabItem><TabItem Header="Участники"><DataGrid x:Name="CatalogParticipants" RowHeight="34" Margin="18,12"><DataGrid.Columns><DataGridTemplateColumn Header="Участник" CellTemplate="{StaticResource PersonCell}" Width="2*"/><DataGridTemplateColumn Header="Доступно" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,0,24,0"/><TextBlock Grid.Column="1" Text="{Binding Available}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FAFBFA" Padding="18,11"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ui:AppIcon Kind="Down" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBlock x:Name="TotalDownload" Text="Приём: —" Margin="0,0,22,0"/><ui:AppIcon Kind="Up" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/><TextBlock x:Name="TotalUpload" Text="Отдача: —"/></StackPanel><Button Style="{StaticResource Quiet}" Padding="0" MinHeight="20" HorizontalContentAlignment="Left" Click="ShowDiagnostics" ToolTip="Журнал и сетевые сведения"><StackPanel Orientation="Horizontal"><Ellipse x:Name="NetworkDot" Width="9" Height="9" Fill="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock x:Name="NetworkLabel" Text="Запуск…" TextTrimming="CharacterEllipsis" MaxWidth="600"/></StackPanel></Button></DockPanel></Border>
  </Grid>
</Window>
