<Window x:Class="PeerFerry.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeerFerry" Width="1100" Height="740" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Обновления" Click="CheckUpdates"/><Button Content="Настройки" Click="OpenSettings" Margin="0"/></StackPanel>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="PeerFerry" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Margin="14,12,0,0" Foreground="#687487"/></StackPanel>
        <TextBlock x:Name="GroupLabel" Text="Подключение…" Margin="0,5,0,0" Style="{StaticResource Hint}"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Padding="16" BorderBrush="#CBD3DF" BorderThickness="1" Background="White" Margin="0,0,0,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Пригласить" Click="CreateInvitation"/><Button Content="Присоединиться" Click="JoinGroup" Margin="0"/></StackPanel>
        <StackPanel><StackPanel Orientation="Horizontal"><Button Content="Добавить файлы" Click="AddFiles"/><Button Content="Добавить папку" Click="AddFolder"/></StackPanel>
          <TextBlock Text="Или перетащите файлы и папки сюда. Они станут доступны вашей группе." Style="{StaticResource Hint}" Margin="0,8,16,0"/></StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="Мои раздачи"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Добавленные вами файлы. Они доступны, пока PeerFerry работает и раздача включена." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
        <DataGrid x:Name="MineGrid" Grid.Row="1" MouseDoubleClick="OpenMineFolder"><DataGrid.Columns><DataGridTextColumn Header="Файл / папка" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="110"/><DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="180"/><DataGridTextColumn Header="Отдача" Binding="{Binding UploadText}" Width="130"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Пауза" Click="PauseMine"/><Button Content="Продолжить" Click="ResumeMine"/><Button Content="Открыть папку" Click="OpenMineFolder"/><Button Content="Убрать из раздач" Click="RemoveMine"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Файлы группы"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Обновить" Click="RefreshPeers" Margin="12,0,0,0"/><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Поиск по имени файла"/></DockPanel>
        <DataGrid x:Name="CatalogGrid" Grid.Row="1" MouseDoubleClick="DownloadSelected"><DataGrid.Columns><DataGridTextColumn Header="Файл / папка" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="110"/><DataGridTextColumn Header="Файлов" Binding="{Binding FileCount}" Width="85"/><DataGridTextColumn Header="Участники с файлом" Binding="{Binding Owners}" Width="250"/></DataGrid.Columns></DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Left" Content="Скачать выбранное" Click="DownloadSelected"/><TextBlock Text="Скачанные части автоматически передаются другим участникам группы." VerticalAlignment="Center" Style="{StaticResource Hint}"/></DockPanel>
      </Grid></TabItem>
      <TabItem Header="Передачи"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="TransfersGrid" MouseDoubleClick="OpenTransferFolder"><DataGrid.Columns>
          <DataGridTextColumn Header="Файл / папка" Binding="{Binding Name}" Width="*"/>
          <DataGridTemplateColumn Header="Прогресс" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="20"/><TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Foreground="#142030" FontSize="12"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="150"/><DataGridTextColumn Header="Приём" Binding="{Binding DownloadText}" Width="110"/><DataGridTextColumn Header="Отдача" Binding="{Binding UploadText}" Width="110"/><DataGridTextColumn Header="Связи" Binding="{Binding Connections}" Width="65"/>
        </DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Пауза" Click="PauseTransfer"/><Button Content="Продолжить" Click="ResumeTransfer"/><Button Content="Открыть папку" Click="OpenTransferFolder"/><Button Content="Убрать из списка" Click="RemoveTransfer"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Участники"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Пригласите друга или вставьте приглашение. Участники одной группы находят друг друга автоматически." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
        <DataGrid x:Name="PeersGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Адреса" Binding="{Binding Addresses}" Width="*"/><DataGridTextColumn Header="Подключение" Binding="{Binding Error}" Width="320"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
      <TabItem Header="Журнал"><TextBox x:Name="LogBox" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusLabel" Text="Запуск…" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NetworkLabel" Margin="0,4,0,0" Foreground="#687487" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel>
  </Grid>
</Window>
